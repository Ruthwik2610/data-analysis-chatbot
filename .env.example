OPENROUTER_API_KEY=your_openrouter_api_key_here
# Comma-separated provider order pinned for openrouter/* models. allow_fallbacks=false.
OPENROUTER_PROVIDER_ORDER=DeepSeek
MODEL=openrouter/deepseek/deepseek-v4-pro
# Used inside the MCP tool-calling agent loop. V4 Pro emits proper `tool_calls` reliably even with
# verbose tool schemas (e.g. Salesforce CLI MCP). V4 Flash is faster per round but leaks DSML
# markup in the final-answer content field, breaking multi-round flows.
AGENT_MODEL=openrouter/deepseek/deepseek-v4-pro

# Arize Phoenix (LLM Observability)
PHOENIX_API_KEY=your_phoenix_api_key_here
PHOENIX_PROJECT_NAME=data-analysis-chatbot
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces

DATA_PATH=/Users/rajasekharbandreddy/Downloads/sourcedata.csv
CACHE_DIR=.cache/chatbot
PROMPT_CHAR_BUDGET=24000

# --- Deployment / security ---
# Required when exposing the API beyond localhost. Frontend must send `Authorization: Bearer $API_KEY`.
# Leave blank only for local development; the server logs a warning on startup if unset.
API_KEY=
# Comma-separated origins allowed by CORS. Set to your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to 1 to allow /sources/api to fetch private/loopback addresses (e.g. internal APIs you trust).
ALLOW_PRIVATE_API_URLS=0
